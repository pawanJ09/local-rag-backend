# Copy to .env and adjust. docker-compose.yml reads these for the backend
# service; config.py reads the same names at runtime inside the container.

EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b

# Swap to a smaller model on constrained/CPU-only hardware, e.g.:
# LLM_MODEL=llama3.2:3b

# Folder on YOUR machine to ingest (mounted read-only into the container at
# /data/docs). Defaults to ./docs next to docker-compose.yml. Use an absolute
# path to point anywhere else, e.g. /Users/you/Documents/notes
DOCS_HOST_DIR=./docs

API_KEY=changeme-local-dev-key
ALLOWED_ORIGINS=http://localhost:5173

TOP_K=5
SIMILARITY_DISTANCE_THRESHOLD=0.45
CHUNK_SIZE=800
CHUNK_OVERLAP=150
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx
