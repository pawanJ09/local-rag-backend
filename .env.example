# Copy to .env and adjust. docker-compose.yml reads these for the backend
# service; config.py reads the same names at runtime inside the container.

EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b

# Task prefixes expected by nomic-embed-text. Leave EMPTY (e.g.
# EMBEDDING_QUERY_PREFIX=) for an embedding model that doesn't use them.
# Changing these requires a full re-ingest (reset chroma_data/).
EMBEDDING_QUERY_PREFIX=search_query
EMBEDDING_DOCUMENT_PREFIX=search_document

# Swap to a smaller model on constrained/CPU-only hardware, e.g.:
# LLM_MODEL=llama3.2:3b

# Folder on YOUR machine to ingest (mounted read-only into the container at
# /data/docs). Defaults to ./docs next to docker-compose.yml. Use an absolute
# path to point anywhere else, e.g. /Users/you/Documents/notes
DOCS_HOST_DIR=./docs

API_KEY=changeme-local-dev-key
ALLOWED_ORIGINS=http://localhost:5173

TOP_K=5

# Off by default. Turn on (true) only if your folder/file names describe the
# documents (e.g. client, property, year). Changing it re-indexes files
# automatically on the next ingest.
EMBED_INCLUDE_PATH=false

# Tell the model that folder/file names are trusted metadata. Only turn on
# if your folder structure reliably describes the documents (e.g. property,
# client, year); with messy folders it can mislead the model. Off = strict.
PATH_AS_EVIDENCE=false
SIMILARITY_DISTANCE_THRESHOLD=0.45
CHUNK_SIZE=800
CHUNK_OVERLAP=150
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx
